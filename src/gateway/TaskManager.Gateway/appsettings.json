{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://seq:5341" } }
    ]
  },
  "Jwt": {
    "Issuer": "TaskManager.Identity",
    "Audience": "TaskManager",
    "SecretKey": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-credentials": {
        "ClusterId": "identity-cluster",
        "Order": 0,
        "RateLimiterPolicy": "auth",
        "Match": { "Path": "/api/auth/{action:regex(^(login|register|refresh)$)}" }
      },
      "auth": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users": {
        "ClusterId": "identity-cluster",
        "Order": 1,
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "boards": {
        "ClusterId": "tasks-cluster",
        "Order": 1,
        "Match": { "Path": "/api/boards/{**catch-all}" }
      },
      "tasks": {
        "ClusterId": "tasks-cluster",
        "Order": 1,
        "Match": { "Path": "/api/tasks/{**catch-all}" }
      },
      "notifications": {
        "ClusterId": "notifications-cluster",
        "Order": 1,
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      },
      "analytics": {
        "ClusterId": "analytics-cluster",
        "Order": 1,
        "Match": { "Path": "/api/analytics/{**catch-all}" }
      },
      "hubs": {
        "ClusterId": "notifications-cluster",
        "Order": 1,
        "Match": { "Path": "/hubs/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": { "default": { "Address": "http://identity-svc:8080" } }
      },
      "tasks-cluster": {
        "Destinations": { "default": { "Address": "http://tasks-svc:8080" } }
      },
      "notifications-cluster": {
        "Destinations": { "default": { "Address": "http://notifications-svc:8080" } }
      },
      "analytics-cluster": {
        "Destinations": { "default": { "Address": "http://analytics-svc:8080" } }
      }
    }
  },
  "AllowedHosts": "*"
}
