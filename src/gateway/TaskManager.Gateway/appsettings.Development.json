{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ]
  },
  "ReverseProxy": {
    "Clusters": {
      "identity-cluster": {
        "Destinations": { "default": { "Address": "http://localhost:5062" } }
      },
      "tasks-cluster": {
        "Destinations": { "default": { "Address": "http://localhost:5159" } }
      },
      "notifications-cluster": {
        "Destinations": { "default": { "Address": "http://localhost:5238" } }
      },
      "analytics-cluster": {
        "Destinations": { "default": { "Address": "http://localhost:5145" } }
      }
    }
  }
}
